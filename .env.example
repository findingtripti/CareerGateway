# Copy this file to .env and fill in your own values. NEVER commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Free LLM for natural-language answers. Choose one: none | gemini | ollama
LLM_PROVIDER=none

# Gemini API free tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional second model used if the first is busy
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Ollama (local, fully free and private): https://ollama.com
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/chat

# Deployment only (leave empty on your own computer)
DATABASE_URL=
DJANGO_SECURE_DEPLOY=False
DJANGO_CSRF_TRUSTED_ORIGINS=

Add-Content .env.example "`n# Embeddings (meaning-based search). Key wahi GEMINI key use hoti hai."
Add-Content .env.example "GEMINI_EMBEDDING_MODEL=gemini-embedding-001"
Add-Content .env.example "EMBEDDING_DIMENSIONS=768"
Add-Content .env.example "EMBEDDING_MIN_SIMILARITY=0.55"
Add-Content .env.example "# EMBEDDINGS=off   (band karna ho to ye line khol do)"
